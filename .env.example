# Copy this file to .env and add ONE key. The server uses whichever is set.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional
# AI_PROVIDER=openai          # force a provider if both keys are set
# OPENAI_MODEL=gpt-6.1-sol
# CLAUDE_MODEL=claude-sonnet-5-5
# PORT=3000
# MAX_TOKENS=4096

# Drawing edits require OPENAI_API_KEY, even when analysis uses Anthropic.
# OPENAI_IMAGE_MODEL=gpt-image-1.5
